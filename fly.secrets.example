# Configura estos secrets en Fly.io antes de desplegar:
#   fly secrets set DB_URL="jdbc:postgresql://HOST:6543/postgres" -a backend-tfg
#   fly secrets set DB_USERNAME="postgres.xxxxx" -a backend-tfg
#   fly secrets set DB_PASSWORD="tu_password" -a backend-tfg
#
# Sin ellos Spring Boot no arranca y verás 502 Bad Gateway.

DB_URL=jdbc:postgresql://tu-pooler.supabase.com:6543/postgres
DB_USERNAME=postgres.tu_proyecto
DB_PASSWORD=tu_password
